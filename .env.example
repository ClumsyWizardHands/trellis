# trellis configuration — copy to .env (via `trellis init`) and fill in.
# The real .env is gitignored. Secrets are referenced by NAME only and never
# written to the ledger or logs. Everything is inert by default: an unconfigured
# trellis touches nothing but the offline demo.

# ---- portal auth (trellis/auth.py) ----
TRELLIS_HUMAN=operator
TRELLIS_APPROVER_SECRET=          # `trellis init` generates one; empty = one-time console token each boot

# ---- ledger (trellis/ledger.py) ----
TRELLIS_LEDGER=state/ledger.jsonl

# ---- model seat: pick ONE (trellis/providers/factory.py) ----
# mock   = offline, no accounts (default for a fresh clone)
# local  = any OpenAI-compatible endpoint (Ollama / LM Studio / llama.cpp) — this is the Gemma seat
# openai = hosted OpenAI with an API key
# claude = Claude Agent SDK — runs on your CLAUDE MAX subscription (or an API key)
# codex  = OpenAI on your CHATGPT SUBSCRIPTION via the official Codex CLI (no API key)
TRELLIS_PROVIDER=mock

# -- if TRELLIS_PROVIDER=local (e.g. Gemma via Ollama) --
TRELLIS_LOCAL_BASE_URL=http://localhost:11434/v1
TRELLIS_LOCAL_MODEL=gemma3
# TRELLIS_LOCAL_API_KEY=not-needed
# TRELLIS_MIN_CONTEXT=16000

# -- if TRELLIS_PROVIDER=openai --
# OPENAI_API_KEY=
# TRELLIS_OPENAI_MODEL=gpt-5.5
# TRELLIS_OPENAI_BASE_URL=https://api.openai.com/v1

# -- if TRELLIS_PROVIDER=claude --
# Runs on your CLAUDE MAX SUBSCRIPTION by default (supported via the Agent SDK):
#   interactive → run `claude login` once, leave ANTHROPIC_API_KEY unset;
#   unattended  → run `claude setup-token`, set CLAUDE_CODE_OAUTH_TOKEN below (~1yr).
# CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` — the daemon-friendly path
# ANTHROPIC_API_KEY=             # OR an API key (per-token billing) — takes precedence if set
# TRELLIS_CLAUDE_MODEL=claude-sonnet-4-5

# -- if TRELLIS_PROVIDER=codex (OpenAI on your ChatGPT subscription, no API key) --
# Install the official Codex CLI, then `codex login` (Sign in with ChatGPT — uses your
# subscription), or `codex login --device-auth` on a headless box, or
# `printenv OPENAI_API_KEY | codex login --with-api-key`. trellis drives the `codex`
# client and NEVER touches its credential (~/.codex/auth.json). It IS a coding agent,
# heavier than a plain chat model — good for "use my OpenAI sub without a key".
# TRELLIS_CODEX_MODEL=            # optional; blank uses Codex's configured default

# ---- the independent VERIFIER seat (trellis/providers/factory.py, D34) ----
# The cheaper Haiku-class model that checks the maker's work (maker != verifier).
# Refuses to start if it equals the maker seat. Defaults to the maker's provider.
# TRELLIS_VERIFIER_PROVIDER=claude
# TRELLIS_VERIFIER_MODEL=claude-haiku-4-5-20251001

# ---- Obsidian vault (trellis/vault.py) — optional, no credential, just a path ----
# TRELLIS_VAULT_PATH=~/Obsidian/MyVault/trellis

# ---- Discord (trellis/isolation.py, D30/D38/D40) — optional; your OWN bot ----
# trellis authenticates as its OWN identity (never reuse another agent's token).
# TRELLIS_DISCORD_TOKEN=          # your bot token — treat like a password; if this
#                                # ever lands in a chat/log, RESET it in the portal
# TRELLIS_DISCORD_GUILD=          # your server id. With READ_SURFACES unset (or
#                                # `auto`), trellis reads EVERYTHING its bot can
#                                # see there (D40) — every public channel + any
#                                # private one you invite the bot into. The grant
#                                # is edited in Discord, not here.
# TRELLIS_READ_SURFACES=          # optional explicit channel-id list; overrides
#                                # the guild-wide auto scope when set.
#                                # An allowlisted channel implies its threads (D32).
# TRELLIS_ACT_SURFACES=           # channel ids trellis may POST to — a separate, smaller set.
#                                # KEEP EMPTY for the first live run: it reads + stages but
#                                # physically cannot send until you arm one channel here.
# TRELLIS_APPROVER_DISCORD_ID=    # YOUR Discord user id — the only reactor whose ✅ approves a
#                                # staged send (D38). Everyone else's reaction is ignored.

# ---- Google Drive (trellis[google]) — optional; wired via `trellis google grant` ----
# The human approves ONCE in a browser; Google's own client writes the token store.
# trellis never handles the raw OAuth secret (see trellis/google_source.py).
# TRELLIS_GOOGLE_CLIENT_SECRET=~/.config/trellis/google_client.json
# TRELLIS_GOOGLE_TOKEN_STORE=~/.config/trellis/google_token.json
# TRELLIS_DRIVE_FOLDER=           # the granted Drive folder id(s), comma-separated —
#                                 # each is an explicit grant; nothing outside is listed

# ---- daily budget (trellis/runner.py, D39) ----
# Subscription seats (codex; claude on the Max login) run UNCAPPED by default —
# they bill nothing per call. Per-token seats (API keys) default to a $5/day cap.
# TRELLIS_DAILY_BUDGET=           # a number to set a cap for any seat; `off` to disable

# ---- the Witness's identity (D44/D46/D50) ----
# The EMP every judgment is formed against. Default: examples/witness-emp.md
# (the standard's demo). An instance points at its own, e.g. the EoC seat:
# TRELLIS_EMP_PATH=examples/chief-of-staff-emp.md

# ---- onboarding / begin-learning ritual (trellis/onboard.py) ----
# TRELLIS_TRANSCRIPTS_DIR=        # local transcript folder(s), comma-separated (.txt/.md/.vtt/.srt)
# TRELLIS_DOCS_DIRS=              # local DOCUMENT folder(s), comma-separated — principles
#                                 # checks, protocols, reference docs (kind=document, not transcript)
# TRELLIS_ONBOARD_TERMS=          # comma-separated seed terms to be curious about,
#                                 # e.g. "empire,overnight soak" — phrases welcome
# TRELLIS_ONBOARD_SECONDS=1800    # how often the background learning pass runs
# TRELLIS_BACKFILL=recency        # D52: `recency` (default) starts at today and
#                                 # descends day-sized slices, deepening where open
#                                 # questions point; `full` = old oldest-first bulk
# TRELLIS_BACKFILL_DAYS=1         # how much history each pass bites off per surface
# TRELLIS_DOCS_PER_PASS=150       # newest-first cap on document ingestion per pass
# TRELLIS_DAYS_PER_PASS=2         # D53: days read as units per pass (rework included)
# TRELLIS_DAY_GATE=on             # D54: each day's reading awaits your Y/N/T before
#                                 # the walk advances (`trellis day` to answer); `off`
#                                 # lets the walk run unattended
